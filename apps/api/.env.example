# Prisma — use Docker Postgres from the host (`docker compose up db`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dataroom?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/dataroom?schema=public"

# Supabase Auth
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# JWT Secret from Supabase Dashboard → Project Settings → API
SUPABASE_JWT_SECRET=""

# Supabase Storage (private PDF bucket; created automatically if missing)
SUPABASE_STORAGE_BUCKET="dataroom-files"

FRONTEND_URL="http://localhost:5173"
PORT=3000
