# Postgres (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dataroom
POSTGRES_PORT=5433

# App ports
API_PORT=3000
WEB_PORT=5173
FRONTEND_URL=http://localhost:5173

# Prisma — local/dev against Docker Postgres (host machine)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dataroom?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/dataroom?schema=public"

# Supabase Auth (still used for Google login / JWT)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Web build args (docker compose) / Vite
VITE_API_URL="http://localhost:3000/api"
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY=""
SUPABASE_STORAGE_BUCKET="dataroom-files"
